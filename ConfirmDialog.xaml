<Window x:Class="BgOptimizer.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="420">
    <Border Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}"
            BorderThickness="1" CornerRadius="10" Margin="16" Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="30" ShadowDepth="6"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap"/>
            <TextBlock x:Name="MessageText" FontSize="12.5" Foreground="{StaticResource TextDimBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,12"/>
            <Border x:Name="ListBorder" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderSoftBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,14" MaxHeight="140" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ItemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource TextDimBrush}"
                                           FontFamily="Consolas" FontSize="11.5" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Style="{StaticResource BtnGhost}" Click="Cancel_Click" IsCancel="True"/>
                <Button x:Name="ConfirmButton" Click="Confirm_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
