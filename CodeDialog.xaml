<Window x:Class="BgOptimizer.CodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="420">
    <Border Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}"
            BorderThickness="1" CornerRadius="10" Margin="16" Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="30" ShadowDepth="6"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap"/>
            <TextBlock x:Name="MessageText" FontSize="12.5" Foreground="{StaticResource TextDimBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,10"/>
            <PasswordBox x:Name="CodeBox" PasswordChanged="Input_Changed"/>
            <TextBlock x:Name="RepeatLabel" Margin="0,6,0,0" Foreground="{StaticResource TextDimBrush}" FontSize="12" Visibility="Collapsed"/>
            <PasswordBox x:Name="RepeatBox" Visibility="Collapsed" PasswordChanged="Input_Changed"/>
            <TextBlock x:Name="ErrorText" Margin="0,6,0,0" Foreground="{StaticResource DangerTextBrush}" FontSize="12.5"
                       TextWrapping="Wrap" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource BtnGhost}" Click="Cancel_Click" IsCancel="True"/>
                <Button x:Name="OkButton" Style="{StaticResource BtnPrimary}" Click="Ok_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
