<Window x:Class="BgOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Background Optimizer" Height="720" Width="1100"
        Background="#1e1e1e">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="RowBackground" Value="#252526"/>
            <Setter Property="AlternatingRowBackground" Value="#2d2d2d"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0e639c"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#e0e0e0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#e0e0e0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="#1e1e1e">
            <!-- PROCESSES TAB -->
            <TabItem Header="Processes">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button Content="Refresh Now" Click="RefreshProcesses_Click"/>
                        <Button Content="Kill Selected" Click="KillProcess_Click"/>
                        <TextBlock Text="Priority:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                        <ComboBox x:Name="PriorityCombo" Width="120" SelectedIndex="0">
                            <ComboBoxItem Content="Idle"/>
                            <ComboBoxItem Content="BelowNormal"/>
                            <ComboBoxItem Content="Normal"/>
                            <ComboBoxItem Content="AboveNormal"/>
                            <ComboBoxItem Content="High"/>
                        </ComboBox>
                        <Button Content="Apply Priority" Click="ApplyPriority_Click"/>
                        <TextBlock Text="Auto-refreshing every 2s. Protected system processes are greyed out and cannot be modified." VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#888"/>
                    </StackPanel>
                    <DataGrid x:Name="ProcessGrid" Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/>
                            <DataGridTextColumn Header="CPU %" Binding="{Binding CpuPercent, StringFormat={}{0:F1}}" Width="80"/>
                            <DataGridTextColumn Header="Memory" Binding="{Binding MemoryDisplay}" Width="100"/>
                            <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="100"/>
                            <DataGridCheckBoxColumn Header="Protected" Binding="{Binding IsProtected}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- STARTUP TAB -->
            <TabItem Header="Startup Apps">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button Content="Refresh" Click="RefreshStartup_Click"/>
                        <Button Content="Enable Selected" Click="EnableStartup_Click"/>
                        <Button Content="Disable Selected" Click="DisableStartup_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="StartupGrid" Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220"/>
                            <DataGridTextColumn Header="Command / Path" Binding="{Binding Command}" Width="420"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding SourceDisplay}" Width="180"/>
                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- SERVICES TAB -->
            <TabItem Header="Services">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button Content="Refresh" Click="RefreshServices_Click"/>
                        <Button Content="Set: Automatic" Click="ServiceAuto_Click"/>
                        <Button Content="Set: Manual" Click="ServiceManual_Click"/>
                        <Button Content="Set: Disabled" Click="ServiceDisabled_Click"/>
                        <Button Content="Stop Now" Click="ServiceStop_Click"/>
                        <TextBlock Text="Protected system services are greyed out and cannot be modified." VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#888"/>
                    </StackPanel>
                    <DataGrid x:Name="ServiceGrid" Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="280"/>
                            <DataGridTextColumn Header="Service Name" Binding="{Binding Name}" Width="180"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Start Type" Binding="{Binding StartType}" Width="100"/>
                            <DataGridCheckBoxColumn Header="Protected" Binding="{Binding IsProtected}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <GroupBox Grid.Row="1" Header="Activity Log" Foreground="#e0e0e0" Margin="0,10,0,0">
            <ListBox x:Name="LogList" Background="#181818" Foreground="#c0c0c0" BorderThickness="0"/>
        </GroupBox>
    </Grid>
</Window>
