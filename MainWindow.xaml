<Window x:Class="BgOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:BgOptimizer.Localization"
        Title="{Binding Source={x:Static loc:Loc.Instance}, Path=[AppTitle]}"
        Icon="icon.ico"
        Height="720" Width="1100"
        MinHeight="480" MinWidth="640"
        Background="{StaticResource BgBrush}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
            <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Lbl_Language]}" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox x:Name="LanguageCombo" AutomationProperties.Name="{Binding Source={x:Static loc:Loc.Instance}, Path=[Lbl_Language]}" Width="140" DisplayMemberPath="Name"/>
        </StackPanel>

        <!-- Shown only in view-only mode, so it is always obvious that nothing is being changed -->
        <Border x:Name="ViewOnlyBanner" Grid.Row="0" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center"
                Margin="0,0,0,6" Padding="10,4" CornerRadius="6" Background="{StaticResource AccentBgBrush}"
                BorderBrush="{StaticResource FocusBrush}" BorderThickness="1">
            <TextBlock FontWeight="SemiBold" Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Set_ViewOnlyBanner]}"/>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" SelectionChanged="MainTabs_SelectionChanged">
            <!-- PROCESSES TAB -->
            <TabItem Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Tab_Processes]}">
                <DockPanel Margin="8">
                    <WrapPanel DockPanel.Dock="Top">
                        <!-- Actions on the selected rows; Kill is last and set apart from Refresh -->
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_RefreshNow]}" Click="RefreshProcesses_Click"/>
                                <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_FreeRam]}" Click="FreeRamSelected_Click"/>
                                <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_FreeRamAll]}" Click="FreeRamAll_Click"/>
                                <Button Style="{StaticResource BtnPrimary}" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_LaptopSaver]}" Click="LaptopSaver_Click"/>
                                <Button Style="{StaticResource BtnDanger}" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_KillSelected]}" Click="KillProcess_Click" Margin="20,4,4,4"/>
                            </StackPanel>
                        </Border>
                        <!-- Priority for the selected rows -->
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Lbl_Priority]}" VerticalAlignment="Center" Margin="6,0,4,0"/>
                                <ComboBox x:Name="PriorityCombo" AutomationProperties.Name="{Binding Source={x:Static loc:Loc.Instance}, Path=[Lbl_Priority]}" Width="120" SelectedIndex="2">
                                    <ComboBoxItem Content="Idle"/>
                                    <ComboBoxItem Content="BelowNormal"/>
                                    <ComboBoxItem Content="Normal"/>
                                    <ComboBoxItem Content="AboveNormal"/>
                                    <ComboBoxItem Content="High"/>
                                </ComboBox>
                                <Button Style="{StaticResource BtnPrimary}" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_ApplyPriority]}" Click="ApplyPriority_Click"/>
                                <CheckBox x:Name="PersistPriorityCheck" Style="{StaticResource ToggleSwitch}" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Chk_PersistPriority]}" VerticalAlignment="Center" Margin="10,0,0,0"
                                          ToolTip="{Binding Source={x:Static loc:Loc.Instance}, Path=[Chk_PersistPriorityHint]}"/>
                                <!-- Caution styling: this override is what lets browsers/shell be slowed down (and can break Cloudflare checks) -->
                                <CheckBox x:Name="AllowInteractiveThrottleCheck" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="10,0,4,0"
                                          Foreground="{StaticResource WarnBrush}"
                                          ToolTip="{Binding Source={x:Static loc:Loc.Instance}, Path=[Chk_AllowInteractiveThrottleHint]}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x26A0;" Foreground="{StaticResource WarnBrush}" Margin="0,0,5,0" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Chk_AllowInteractiveThrottle]}" Foreground="{StaticResource WarnBrush}"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                        <!-- AI Workload Mode: unattended, RAM-pressure-driven -->
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="AutoOptimizeCheck" Style="{StaticResource ToggleSwitch}" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Chk_AutoOptimize]}" VerticalAlignment="Center" Margin="6,0,0,0"
                                          ToolTip="{Binding Source={x:Static loc:Loc.Instance}, Path=[Chk_AutoOptimizeHint]}"/>
                                <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Lbl_FreeRamBelow]}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                <TextBox x:Name="AutoOptimizeThresholdBox" AutomationProperties.Name="{Binding Source={x:Static loc:Loc.Instance}, Path=[Lbl_FreeRamBelow]}" Width="40" Text="2" VerticalContentAlignment="Center"/>
                                <TextBlock Text="GB" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                <CheckBox x:Name="AllowSuspendCheck" Style="{StaticResource ToggleSwitch}" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Chk_AllowSuspend]}" VerticalAlignment="Center" Margin="10,0,0,0"
                                          ToolTip="{Binding Source={x:Static loc:Loc.Instance}, Path=[Chk_AllowSuspendHint]}"/>
                                <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_ResumeAllSuspended]}" Click="ResumeAllSuspended_Click" Margin="10,4,4,4"/>
                                <TextBlock x:Name="SuspendedCountText" VerticalAlignment="Center" Margin="4,0,6,0" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Lbl_Search]}" VerticalAlignment="Center" Margin="6,0,4,0"/>
                                <TextBox x:Name="ProcessSearchBox" AutomationProperties.Name="{Binding Source={x:Static loc:Loc.Instance}, Path=[Lbl_Search]}" Width="180" VerticalContentAlignment="Center" TextChanged="ProcessSearch_TextChanged"/>
                                <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Hint_ProcessesAutoRefresh]}" VerticalAlignment="Center" Margin="10,0,6,0" Foreground="{StaticResource TextFaintBrush}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,8,0,4">
                        <!-- Number on the left, sparkline on the right, so the line never runs through the figure -->
                        <Border Width="260" Height="64" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="10,8,8,0">
                                    <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Lbl_Cpu]}" Foreground="{StaticResource TextFaintBrush}" FontSize="11"/>
                                    <TextBlock x:Name="CpuUsageText" Text="--" FontSize="18" FontWeight="Bold"/>
                                </StackPanel>
                                <Canvas Grid.Column="1" x:Name="CpuGraphCanvas" ClipToBounds="True" Margin="0,8,8,8"/>
                            </Grid>
                        </Border>
                        <Border Width="260" Height="64" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="10,8,8,0">
                                    <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Lbl_Memory]}" Foreground="{StaticResource TextFaintBrush}" FontSize="11"/>
                                    <TextBlock x:Name="MemoryUsageText" Text="--" FontSize="18" FontWeight="Bold"/>
                                </StackPanel>
                                <Canvas Grid.Column="1" x:Name="MemoryGraphCanvas" ClipToBounds="True" Margin="0,8,8,8"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <DataGrid x:Name="ProcessGrid" AutomationProperties.Name="{Binding Source={x:Static loc:Loc.Instance}, Path=[Tab_Processes]}" Margin="0,8,0,0" RowStyle="{StaticResource ProtectedRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Name]}" Binding="{Binding Name}" Width="220" ElementStyle="{StaticResource TrimTextCell}"/>
                            <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Pid]}" Binding="{Binding Pid}" Width="70"/>
                            <DataGridTemplateColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_CpuPercent]}" SortMemberPath="CpuPercent" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Glyph + weight repeat the colour so severity isn't colour-only -->
                                            <TextBlock Text="{Binding CpuPercent, Converter={StaticResource CpuSeverityBrush}}" Width="14" FontSize="10" VerticalAlignment="Center"
                                                       Foreground="{Binding CpuPercent, Converter={StaticResource CpuSeverityBrush}}"/>
                                            <TextBlock Text="{Binding CpuPercent, StringFormat={}{0:F1}}"
                                                       FontWeight="{Binding CpuPercent, Converter={StaticResource CpuSeverityBrush}}"
                                                       Foreground="{Binding CpuPercent, Converter={StaticResource CpuSeverityBrush}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Memory]}" SortMemberPath="MemoryBytes" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Glyph + weight repeat the colour so severity isn't colour-only -->
                                            <TextBlock Text="{Binding MemoryBytes, Converter={StaticResource MemorySeverityBrush}}" Width="14" FontSize="10" VerticalAlignment="Center"
                                                       Foreground="{Binding MemoryBytes, Converter={StaticResource MemorySeverityBrush}}"/>
                                            <TextBlock Text="{Binding MemoryDisplay}"
                                                       FontWeight="{Binding MemoryBytes, Converter={StaticResource MemorySeverityBrush}}"
                                                       Foreground="{Binding MemoryBytes, Converter={StaticResource MemorySeverityBrush}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Priority]}" SortMemberPath="Priority" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Glyph + weight repeat the colour so severity isn't colour-only -->
                                            <TextBlock Text="{Binding Priority, Converter={StaticResource PrioritySeverityBrush}}" Width="14" FontSize="10" VerticalAlignment="Center"
                                                       Foreground="{Binding Priority, Converter={StaticResource PrioritySeverityBrush}}"/>
                                            <TextBlock Text="{Binding Priority}"
                                                       FontWeight="{Binding Priority, Converter={StaticResource PrioritySeverityBrush}}"
                                                       Foreground="{Binding Priority, Converter={StaticResource PrioritySeverityBrush}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Protected]}" Binding="{Binding IsProtected, Converter={StaticResource ProtectedToLockGlyph}}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Status]}" Width="*" MinWidth="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Lbl_Suspended]}" Foreground="{StaticResource TextFaintBrush}"
                                                       Visibility="{Binding IsSuspended, Converter={StaticResource BoolToVisibility}}"/>
                                            <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_RestartHog]}" Tag="{Binding}" Click="RestartHog_Click"
                                                    Visibility="{Binding IsHog, Converter={StaticResource BoolToVisibility}}" Padding="4,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- STARTUP TAB -->
            <TabItem Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Tab_Startup]}">
                <DockPanel Margin="8">
                    <WrapPanel DockPanel.Dock="Top">
                        <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_Refresh]}" Click="RefreshStartup_Click"/>
                        <Button Style="{StaticResource BtnPrimary}" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_EnableSelected]}" Click="EnableStartup_Click"/>
                        <Button Style="{StaticResource BtnDanger}" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_DisableSelected]}" Click="DisableStartup_Click"/>
                        <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Lbl_Search]}" VerticalAlignment="Center" Margin="16,0,4,0"/>
                        <TextBox x:Name="StartupSearchBox" AutomationProperties.Name="{Binding Source={x:Static loc:Loc.Instance}, Path=[Lbl_Search]}" Width="180" VerticalContentAlignment="Center" TextChanged="StartupSearch_TextChanged"/>
                        <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[St_OpenSettings]}" Click="OpenStartupSettings_Click" Margin="16,4,4,4"/>
                    </WrapPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,6,0,0">
                        <CheckBox x:Name="AutoRestorePointCheck" Style="{StaticResource ToggleSwitch}" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Chk_AutoRestorePoint]}" VerticalAlignment="Center" IsChecked="True"/>
                        <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_CreateRestorePoint]}" Click="CreateRestorePoint_Click" Margin="12,0,0,0"/>
                        <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Hint_CategoryNote]}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource TextFaintBrush}"/>
                    </WrapPanel>
                    <!-- What the selected item is and what it runs: the plain-language line the grid has no room for -->
                    <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="10,8" CornerRadius="6" MinHeight="64"
                            Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
                        <TextBlock x:Name="StartupDetailsText" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}"/>
                    </Border>
                    <DataGrid x:Name="StartupGrid" AutomationProperties.Name="{Binding Source={x:Static loc:Loc.Instance}, Path=[Tab_Startup]}" Margin="0,8,0,0" RowStyle="{StaticResource BaseRowStyle}"
                              SelectionChanged="StartupGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Name]}" Binding="{Binding Name}" Width="170" ElementStyle="{StaticResource TrimTextCell}"/>
                            <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Command]}" Binding="{Binding Command}" Width="280" ElementStyle="{StaticResource TrimTextCell}"/>
                            <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Source]}" Binding="{Binding SourceDisplay}" Width="150" ElementStyle="{StaticResource TrimTextCell}"/>
                            <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Category]}" Binding="{Binding CategoryDisplay}" Width="120" ElementStyle="{StaticResource TrimTextCell}"/>
                            <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[St_Col_Publisher]}" Binding="{Binding PublisherDisplay}" Width="150" ElementStyle="{StaticResource TrimTextCell}"/>
                            <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_Col_Note]}" Binding="{Binding NoteDisplay}" Width="200" ElementStyle="{StaticResource TrimTextCell}"/>
                            <DataGridCheckBoxColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Enabled]}" Binding="{Binding Enabled}" Width="80"
                                                    ElementStyle="{StaticResource ReadOnlyCheckCell}" EditingElementStyle="{StaticResource ReadOnlyCheckCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- SERVICES TAB -->
            <TabItem Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Tab_Services]}">
                <DockPanel Margin="8">
                    <WrapPanel DockPanel.Dock="Top">
                        <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_Refresh]}" Click="RefreshServices_Click"/>
                        <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_SetAutomatic]}" Click="ServiceAuto_Click"/>
                        <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_SetManual]}" Click="ServiceManual_Click"/>
                        <Button Style="{StaticResource BtnDanger}" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_SetDisabled]}" Click="ServiceDisabled_Click"/>
                        <Button Style="{StaticResource BtnDanger}" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_StopNow]}" Click="ServiceStop_Click"/>
                        <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Lbl_Search]}" VerticalAlignment="Center" Margin="16,0,4,0"/>
                        <TextBox x:Name="ServiceSearchBox" AutomationProperties.Name="{Binding Source={x:Static loc:Loc.Instance}, Path=[Lbl_Search]}" Width="180" VerticalContentAlignment="Center" TextChanged="ServiceSearch_TextChanged"/>
                        <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Hint_ServicesProtected]}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource TextFaintBrush}"/>
                    </WrapPanel>
                    <DataGrid x:Name="ServiceGrid" AutomationProperties.Name="{Binding Source={x:Static loc:Loc.Instance}, Path=[Tab_Services]}" Margin="0,8,0,0" RowStyle="{StaticResource ProtectedRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_DisplayName]}" Binding="{Binding DisplayName}" Width="250" ElementStyle="{StaticResource TrimTextCell}"/>
                            <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_ServiceName]}" Binding="{Binding Name}" Width="160" ElementStyle="{StaticResource TrimTextCell}"/>
                            <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Status]}" Binding="{Binding Status}" Width="90"/>
                            <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_StartType]}" Binding="{Binding StartType}" Width="90"/>
                            <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Category]}" Binding="{Binding CategoryDisplay}" Width="140"/>
                            <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Protected]}" Binding="{Binding IsProtected, Converter={StaticResource ProtectedToLockGlyph}}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- CLEANUP TAB -->
            <TabItem Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Tab_Cleanup]}">
                <DockPanel Margin="8">
                    <WrapPanel DockPanel.Dock="Top">
                        <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_CleanupScan]}" Click="CleanupScan_Click"/>
                        <Button Style="{StaticResource BtnDanger}" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_CleanupRun]}" Click="CleanupRun_Click"/>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}"
                               Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Hint_Cleanup]}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <ItemsControl x:Name="CleanupList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" AutomationProperties.Name="{Binding Name}" VerticalContentAlignment="Top">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" VerticalAlignment="Top" Margin="16,0,8,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- CHECKS TAB: read-only scans (leftovers of deleted programs, duplicate files, duplicate drivers).
                 One sub-tab per scan, so the result grid gets the whole height of the window instead of a
                 220 px slot inside a scrolling page. -->
            <TabItem Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Tab_Checks]}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <Button x:Name="CheckStopButton" DockPanel.Dock="Right" IsEnabled="False" Style="{StaticResource BtnDanger}"
                                Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_Stop]}" Click="CheckStop_Click"/>
                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource TextFaintBrush}"
                                   Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_Hint]}"/>
                    </DockPanel>

                    <TabControl x:Name="ChecksSubTabs" Grid.Row="1">
                        <!-- Leftovers of deleted programs -->
                        <TabItem Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_TabLeft]}">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_LeftTitle]}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}" Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_LeftHint]}"/>
                                </StackPanel>
                                <WrapPanel Grid.Row="1" Margin="0,6,0,0">
                                    <Button x:Name="LeftoverScanButton" Style="{StaticResource BtnPrimary}" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_Scan]}" Click="LeftoverScan_Click"/>
                                    <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_OpenLocation]}" Click="LeftoverOpen_Click"/>
                                    <TextBlock x:Name="LeftoverStatusText" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
                                </WrapPanel>
                                <DataGrid x:Name="LeftoverGrid" Grid.Row="2" MinHeight="120" Margin="0,6,0,0" RowStyle="{StaticResource BaseRowStyle}"
                                          AutomationProperties.Name="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_LeftTitle]}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_Col_Type]}" Binding="{Binding Kind}" Width="230" ElementStyle="{StaticResource TrimTextCell}"/>
                                        <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Name]}" Binding="{Binding Name}" Width="170" ElementStyle="{StaticResource TrimTextCell}"/>
                                        <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_Col_Location]}" Binding="{Binding Path}" Width="*" MinWidth="200" ElementStyle="{StaticResource TrimTextCell}"/>
                                        <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_Col_Size]}" Binding="{Binding Size}" Width="80"/>
                                        <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_Col_Note]}" Binding="{Binding Note}" Width="220" ElementStyle="{StaticResource TrimTextCell}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- Duplicate files -->
                        <TabItem Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_DupTitle]}">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}" Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_DupHint]}"/>
                                <WrapPanel Grid.Row="1" Margin="0,6,0,0">
                                    <Button x:Name="DupScanButton" Style="{StaticResource BtnPrimary}" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_DupScanDefault]}" Click="DuplicateScan_Click"/>
                                    <Button x:Name="DupScanFolderButton" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_DupScanFolder]}" Click="DuplicateScanFolder_Click"/>
                                    <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_OpenLocation]}" Click="DuplicateOpen_Click"/>
                                    <TextBlock x:Name="DuplicateStatusText" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
                                </WrapPanel>
                                <DataGrid x:Name="DuplicateGrid" Grid.Row="2" MinHeight="120" Margin="0,6,0,0" RowStyle="{StaticResource BaseRowStyle}"
                                          AutomationProperties.Name="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_DupTitle]}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_Col_Group]}" Binding="{Binding Group}" Width="70"/>
                                        <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Name]}" Binding="{Binding Name}" Width="260" ElementStyle="{StaticResource TrimTextCell}"/>
                                        <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_Col_Folder]}" Binding="{Binding Folder}" Width="*" MinWidth="200" ElementStyle="{StaticResource TrimTextCell}"/>
                                        <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_Col_Size]}" Binding="{Binding Size}" Width="90"/>
                                        <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_Col_Modified]}" Binding="{Binding Modified}" Width="140"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- Duplicate drivers -->
                        <TabItem Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_DrvTitle]}">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}" Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_DrvHint]}"/>
                                <WrapPanel Grid.Row="1" Margin="0,6,0,0">
                                    <Button x:Name="DriverScanButton" Style="{StaticResource BtnPrimary}" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_Scan]}" Click="DriverScan_Click"/>
                                    <Button x:Name="DriverOpenButton" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_DrvOpenFolder]}" Click="DriverOpen_Click"/>
                                    <Button x:Name="DriverSelectOldButton" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_DrvSelectOld]}" Click="DriverSelectOld_Click"/>
                                    <Button x:Name="DriverDeleteButton" Style="{StaticResource BtnDanger}" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_DrvDelete]}" Click="DriverDelete_Click"/>
                                    <TextBlock x:Name="DriverStatusText" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
                                </WrapPanel>
                                <DataGrid x:Name="DriverGrid" Grid.Row="2" MinHeight="120" Margin="0,6,0,0" RowStyle="{StaticResource BaseRowStyle}"
                                          AutomationProperties.Name="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_DrvTitle]}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_Col_Driver]}" Binding="{Binding Driver}" Width="200" ElementStyle="{StaticResource TrimTextCell}"/>
                                        <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_Col_Version]}" Binding="{Binding Version}" Width="130" ElementStyle="{StaticResource TrimTextCell}"/>
                                        <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_Col_Date]}" Binding="{Binding Date}" Width="95"/>
                                        <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Status]}" Binding="{Binding Status}" Width="200" ElementStyle="{StaticResource TrimTextCell}"/>
                                        <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_Col_Published]}" Binding="{Binding PublishedName}" Width="110"/>
                                        <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_Col_Size]}" Binding="{Binding Size}" Width="90"/>
                                        <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Ck_Col_Provider]}" Binding="{Binding Provider}" Width="*" MinWidth="120" ElementStyle="{StaticResource TrimTextCell}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <!-- SECURITY TAB -->
            <TabItem x:Name="SecurityTab" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Tab_Security]}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Sec_Firewall]}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="FirewallStatusText" Margin="0,4,0,16" Foreground="{StaticResource TextDimBrush}"/>

                    <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Sec_WinRm]}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Sec_WinRmHint]}" Foreground="{StaticResource TextFaintBrush}"/>
                    <TextBlock x:Name="WinRmStatusText" Margin="0,4,0,0" Foreground="{StaticResource TextDimBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                        <Button Style="{StaticResource BtnDanger}" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_Disable]}" Click="WinRmDisable_Click"/>
                        <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_Enable]}" Click="WinRmEnable_Click"/>
                    </StackPanel>

                    <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Sec_Smb]}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Sec_SmbHint]}" Foreground="{StaticResource TextFaintBrush}"/>
                    <TextBlock x:Name="SmbStatusText" Margin="0,4,0,0" Foreground="{StaticResource TextDimBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Style="{StaticResource BtnDanger}" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_Block]}" Click="SmbBlock_Click"/>
                        <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_Unblock]}" Click="SmbUnblock_Click"/>
                        <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_Refresh]}" Click="RefreshSecurity_Click" Margin="12,0,0,0"/>
                    </StackPanel>

                    <TextBlock Margin="0,16,0,0" Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Sec_AppFw]}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Sec_AppFwHint]}" Foreground="{StaticResource TextFaintBrush}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Style="{StaticResource BtnDanger}" Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_BlockApp]}" Click="AppBlock_Click"/>
                        <ComboBox x:Name="BlockedAppsCombo" AutomationProperties.Name="{Binding Source={x:Static loc:Loc.Instance}, Path=[Sec_AppFw]}" MinWidth="320" Margin="8,0,0,0"/>
                        <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_RemoveRule]}" Click="AppUnblock_Click"/>
                    </StackPanel>

                    <TextBlock Margin="0,16,0,0" Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Sec_Battery]}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="BatteryHealthText" Margin="0,4,0,12" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Sec_HibernateHint]}" Foreground="{StaticResource TextFaintBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="HibernateStatusText" Margin="0,4,0,0" Foreground="{StaticResource TextDimBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_Enable]}" Click="HibernateOnLidEnable_Click"/>
                        <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_Disable]}" Click="HibernateOnLidDisable_Click"/>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- TWEAKS TAB -->
            <TabItem Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Tab_Tweaks]}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Tw_Hint]}" Foreground="{StaticResource TextFaintBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <StackPanel x:Name="TweakList"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- SETTINGS TAB: view-only mode and the system load panel -->
            <TabItem x:Name="SettingsTab" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Tab_Settings]}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" MaxWidth="780" HorizontalAlignment="Left">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Set_ModeTitle]}"/>
                        <CheckBox x:Name="ViewOnlyCheck" Style="{StaticResource ToggleSwitch}" Margin="0,8,0,0"
                                  Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Set_ViewOnly]}"/>
                        <TextBlock Margin="50,2,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}"
                                   Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Set_ViewOnlyHint]}"/>
                        <TextBlock Margin="50,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}"
                                   Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Set_ViewOnlyNoSelect]}"/>

                        <!-- Optional code: without it nobody can switch view-only mode off -->
                        <TextBlock Margin="0,18,0,0" FontWeight="SemiBold" Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Set_CodeTitle]}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}"
                                   Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Set_CodeHint]}"/>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock x:Name="CodeStatusText" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                            <Button x:Name="CodeSetButton" Margin="0,4,4,4"/>
                            <Button x:Name="CodeRemoveButton"/>
                        </WrapPanel>

                        <TextBlock Margin="0,26,0,0" FontWeight="SemiBold" Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Set_LoadTitle]}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}"
                                   Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Set_LoadHint]}"/>
                        <StackPanel x:Name="LoadMeterPanel" Margin="0,12,0,0"/>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Set_LoadLimit]}"/>
                            <Slider x:Name="LoadLimitSlider" Grid.Column="1" Minimum="50" Maximum="100" SmallChange="1" LargeChange="5"
                                    VerticalAlignment="Center" Margin="0,0,12,0"
                                    AutomationProperties.Name="{Binding Source={x:Static loc:Loc.Instance}, Path=[Set_LoadLimit]}"/>
                            <TextBlock x:Name="LoadLimitValueText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Grid>

                        <CheckBox x:Name="LoadAlertCheck" Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0"
                                  Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Set_LoadAlert]}"/>
                        <TextBlock Margin="50,2,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}"
                                   Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Set_LoadAlertHint]}"/>

                        <CheckBox x:Name="AutoOptimizeOnLoadCheck" Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0"
                                  Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Set_LoadOptimize]}"/>
                        <TextBlock Margin="50,2,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}"
                                   Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Set_LoadOptimizeHint]}"/>

                        <!-- Programs the app must never slow down, trim or freeze: the user's own protected list -->
                        <TextBlock Margin="0,26,0,0" FontWeight="SemiBold" Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Set_NeverTitle]}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}"
                                   Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Set_NeverHint]}"/>
                        <TextBox x:Name="NeverTouchBox" Margin="0,8,0,0" MaxLength="1000" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="{Binding Source={x:Static loc:Loc.Instance}, Path=[Set_NeverName]}"/>

                        <!-- Cooling: what Windows reports about heat, and the one safe lever (a CPU speed cap) -->
                        <TextBlock Margin="0,26,0,0" FontWeight="SemiBold" Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Set_CoolTitle]}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}"
                                   Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Set_CoolHint]}"/>
                        <StackPanel Margin="0,8,0,0" AutomationProperties.Name="{Binding Source={x:Static loc:Loc.Instance}, Path=[Set_CoolTitle]}">
                            <TextBlock x:Name="CoolTempText"/>
                            <TextBlock x:Name="CoolSpeedText"/>
                            <TextBlock x:Name="CoolStatusText" Margin="0,2,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>
                        <WrapPanel Margin="0,12,0,0">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Set_CoolLimit]}"/>
                            <ComboBox x:Name="CpuLimitCombo" Width="120"
                                      AutomationProperties.Name="{Binding Source={x:Static loc:Loc.Instance}, Path=[Set_CoolLimit]}"/>
                            <Button x:Name="CpuLimitApplyButton" Style="{StaticResource BtnPrimary}" Click="CpuLimitApply_Click"
                                    Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Set_CoolApply]}"/>
                        </WrapPanel>
                        <TextBlock x:Name="CpuLimitStatusText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="6" Margin="0,10,0,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="10,6,6,6">
                    <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[GroupBox_ActivityLog]}" Foreground="{StaticResource TextFaintBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Undo is global (one LIFO stack across every tab), so it lives with the log of what was done -->
                        <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_UndoLast]}" Padding="8,2" FontSize="11" Click="UndoLast_Click"/>
                        <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_ClearLog]}" Padding="8,2" FontSize="11" Click="ClearLog_Click"/>
                    </StackPanel>
                </Grid>
                <ListBox x:Name="LogList" AutomationProperties.Name="{Binding Source={x:Static loc:Loc.Instance}, Path=[GroupBox_ActivityLog]}" Background="Transparent" Foreground="{StaticResource TextDimBrush}" BorderThickness="0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
