<Window x:Class="BgOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:BgOptimizer.Localization"
        Title="{Binding Source={x:Static loc:Loc.Instance}, Path=[AppTitle]}"
        Icon="icon.ico"
        Height="720" Width="1100"
        Background="#1e1e1e">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="RowBackground" Value="#252526"/>
            <Setter Property="AlternatingRowBackground" Value="#2d2d2d"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0e639c"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#e0e0e0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#e0e0e0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
            <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Lbl_Language]}" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox x:Name="LanguageCombo" Width="140" DisplayMemberPath="Name"/>
        </StackPanel>

        <TabControl Grid.Row="1" Background="#1e1e1e">
            <!-- PROCESSES TAB -->
            <TabItem Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Tab_Processes]}">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_RefreshNow]}" Click="RefreshProcesses_Click"/>
                        <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_KillSelected]}" Click="KillProcess_Click"/>
                        <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Lbl_Priority]}" VerticalAlignment="Center" Margin="12,0,4,0"/>
                        <ComboBox x:Name="PriorityCombo" Width="120" SelectedIndex="0">
                            <ComboBoxItem Content="Idle"/>
                            <ComboBoxItem Content="BelowNormal"/>
                            <ComboBoxItem Content="Normal"/>
                            <ComboBoxItem Content="AboveNormal"/>
                            <ComboBoxItem Content="High"/>
                        </ComboBox>
                        <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_ApplyPriority]}" Click="ApplyPriority_Click"/>
                        <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Hint_ProcessesAutoRefresh]}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#888"/>
                    </StackPanel>
                    <DataGrid x:Name="ProcessGrid" Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Name]}" Binding="{Binding Name}" Width="220"/>
                            <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Pid]}" Binding="{Binding Pid}" Width="70"/>
                            <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_CpuPercent]}" Binding="{Binding CpuPercent, StringFormat={}{0:F1}}" Width="80"/>
                            <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Memory]}" Binding="{Binding MemoryDisplay}" Width="100"/>
                            <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Priority]}" Binding="{Binding Priority}" Width="100"/>
                            <DataGridCheckBoxColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Protected]}" Binding="{Binding IsProtected}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- STARTUP TAB -->
            <TabItem Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Tab_Startup]}">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_Refresh]}" Click="RefreshStartup_Click"/>
                        <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_EnableSelected]}" Click="EnableStartup_Click"/>
                        <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_DisableSelected]}" Click="DisableStartup_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="StartupGrid" Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Name]}" Binding="{Binding Name}" Width="220"/>
                            <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Command]}" Binding="{Binding Command}" Width="420"/>
                            <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Source]}" Binding="{Binding SourceDisplay}" Width="180"/>
                            <DataGridCheckBoxColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Enabled]}" Binding="{Binding Enabled}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- SERVICES TAB -->
            <TabItem Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Tab_Services]}">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_Refresh]}" Click="RefreshServices_Click"/>
                        <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_SetAutomatic]}" Click="ServiceAuto_Click"/>
                        <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_SetManual]}" Click="ServiceManual_Click"/>
                        <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_SetDisabled]}" Click="ServiceDisabled_Click"/>
                        <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[Btn_StopNow]}" Click="ServiceStop_Click"/>
                        <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[Hint_ServicesProtected]}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#888"/>
                    </StackPanel>
                    <DataGrid x:Name="ServiceGrid" Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_DisplayName]}" Binding="{Binding DisplayName}" Width="280"/>
                            <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_ServiceName]}" Binding="{Binding Name}" Width="180"/>
                            <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Status]}" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_StartType]}" Binding="{Binding StartType}" Width="100"/>
                            <DataGridCheckBoxColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[Col_Protected]}" Binding="{Binding IsProtected}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <GroupBox Grid.Row="2" Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[GroupBox_ActivityLog]}" Foreground="#e0e0e0" Margin="0,10,0,0">
            <ListBox x:Name="LogList" Background="#181818" Foreground="#c0c0c0" BorderThickness="0"/>
        </GroupBox>
    </Grid>
</Window>
